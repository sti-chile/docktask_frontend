<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" modified="2026-02-26" version="21.0.0">
  <diagram name="Offline Sync Flow" id="offline-sync">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- TÍTULO -->
        <mxCell id="title" value="DockTask — Flujo Offline / Sync" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=18;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="570" height="40" as="geometry" />
        </mxCell>

        <!-- INICIO -->
        <mxCell id="start" value="Usuario ejecuta acción&#xa;(crear/editar tarea)" style="ellipse;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="440" y="80" width="220" height="60" as="geometry" />
        </mxCell>

        <!-- ¿Hay red? -->
        <mxCell id="net-check" value="¿Hay conexión a internet?" style="rhombus;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="420" y="180" width="260" height="80" as="geometry" />
        </mxCell>

        <!-- SÍ hay red → directo al backend -->
        <mxCell id="online-path" value="ONLINE" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#82b366;fontStyle=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="net-check" target="api-call" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- NO hay red → SQLite local -->
        <mxCell id="offline-path" value="OFFLINE" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#b85450;fontStyle=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="net-check" target="sqlite-write" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===================== RAMA ONLINE ===================== -->
        <mxCell id="api-call" value="POST/PATCH al&#xa;Python Backend API" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="760" y="190" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="api-ok" value="¿Respuesta OK?" style="rhombus;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="760" y="290" width="200" height="70" as="geometry" />
        </mxCell>

        <mxCell id="api-ok-path" edge="1" source="api-call" target="api-ok" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="ui-update-online" value="✅ Actualizar UI&#xa;(React Query invalidate)" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="760" y="400" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="e-api-ok-yes" value="Sí" edge="1" source="api-ok" target="ui-update-online" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Error online → fallback a SQLite -->
        <mxCell id="e-api-ok-no" value="No (error red)" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#b85450;" edge="1" source="api-ok" target="sqlite-write" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="860" y="420" />
              <mxPoint x="860" y="540" />
              <mxPoint x="200" y="540" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ===================== RAMA OFFLINE ===================== -->
        <mxCell id="sqlite-write" value="Escribir en SQLite local&#xa;(synced: false)" style="shape=cylinder3;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="90" y="290" width="180" height="80" as="geometry" />
        </mxCell>

        <mxCell id="ui-update-offline" value="✅ Actualizar UI&#xa;(desde SQLite local)" style="rounded=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="90" y="420" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="e-sqlite-ui" edge="1" source="sqlite-write" target="ui-update-offline" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===================== SYNC WORKER ===================== -->
        <mxCell id="sync-bg" value="Sync Worker (Rust thread — cada 30s)" style="swimlane;fillColor=#f8cecc;strokeColor=#b85450;startSize=30;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="560" width="600" height="200" as="geometry" />
        </mxCell>

        <mxCell id="sync-check" value="¿Hay registros&#xa;synced: false?" style="rhombus;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="300" y="600" width="180" height="70" as="geometry" />
        </mxCell>

        <mxCell id="sync-upload" value="Subir cambios al&#xa;Python Backend" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="520" y="610" width="160" height="50" as="geometry" />
        </mxCell>

        <mxCell id="sync-mark" value="Marcar synced: true&#xa;en SQLite" style="rounded=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="520" y="690" width="160" height="50" as="geometry" />
        </mxCell>

        <mxCell id="e-sync-check-yes" value="Sí" edge="1" source="sync-check" target="sync-upload" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e-sync-upload-mark" edge="1" source="sync-upload" target="sync-mark" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Flechas que conectan hacia el sync worker -->
        <mxCell id="e-offline-to-sync" value="pending sync" style="edgeStyle=orthogonalEdgeStyle;dashed=1;strokeColor=#b85450;" edge="1" source="sqlite-write" target="sync-check" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="180" y="530" />
              <mxPoint x="390" y="530" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Flecha desde start a net-check -->
        <mxCell id="e-start-check" edge="1" source="start" target="net-check" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Nota de conflicto -->
        <mxCell id="conflict-note" value="⚠️ Conflicto de versiones:&#xa;El backend usa timestamp&#xa;para detectar el más reciente&#xa;(Last-Write-Wins)" style="shape=note;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="760" y="560" width="180" height="90" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
